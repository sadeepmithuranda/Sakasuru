# ---- API (apps/api) ----
DATABASE_URL=postgres://sakasuru:sakasuru@localhost:5432/sakasuru
DATABASE_SSL=false
# 32+ random characters each — generate with: openssl rand -base64 32
JWT_SECRET=
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
# Use "none" only when the web app is on a different site than the API (requires HTTPS)
COOKIE_SAMESITE=lax
# Optional: serve the built web app from the API
WEB_DIST_DIR=../web/dist
# Optional: first super administrator (created by `pnpm db:seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: LLM phrasing for knowledge answers (answers stay grounded in the verified knowledge base)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ---- Web (apps/web) ----
# Leave empty for the on-device demo mode; "/" when served by the API; or the API's URL
VITE_API_URL=
